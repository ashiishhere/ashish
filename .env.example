# Database (PostgreSQL - e.g. Vercel Postgres, Supabase, Neon, Railway)
DATABASE_URL="postgresql://user:password@host:5432/ashish_portfolio?schema=public"

# Auth.js
AUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Seed admin account (used only by prisma/seed.ts)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-strong-password"

# Cloudinary (image storage for award images, thumbnails)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public site URL (used for SEO, sitemap, canonical URLs, OG tags)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
